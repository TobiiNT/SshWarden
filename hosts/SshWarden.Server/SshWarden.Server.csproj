<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SshWarden.Server</RootNamespace>
    <Description>The SshWarden deployable.</Description>
    <UserSecretsId>sshwarden-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SshWarden.Mcp/SshWarden.Mcp.csproj" />
    <!--
      The generic adapter, which works with any authorization server issuing JWT access tokens. This
      host is what somebody runs, and wiring it to one particular server's packages once made "does
      it work with mine?" answerable only by editing this file.

      It is the only adapter shipped now, and it stays a ProjectReference rather than something
      AddSshWarden pulls in: a static-token install is not made to carry an authorization server's
      client libraries. A deployment writing its own adapter swaps this line and nothing else.
    -->
    <ProjectReference Include="../../src/SshWarden.OAuth/SshWarden.OAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SshWarden.Mcp.Tests" />
  </ItemGroup>

</Project>
